# Explicit local development profile. Production operators must replace every value and set APP_ENV=production.
APP_ENV=docker

APP_DBS_PRIMARY_HOST=host.docker.internal
APP_DBS_PRIMARY_PORT=5432
APP_DBS_PRIMARY_NAME=sweet_admin
APP_DBS_PRIMARY_USER=sweet_admin
APP_DBS_PRIMARY_PASSWORD=sweet_admin
APP_DBS_PRIMARY_TLS_MODE=disable
APP_DBS_PRIMARY_TLS_ROOT_CA_FILE=
APP_DBS_PRIMARY_TLS_CERT_FILE=
APP_DBS_PRIMARY_TLS_KEY_FILE=

APP_REDIS_HOST=host.docker.internal
APP_REDIS_PORT=6379
APP_REDIS_DB=5
APP_REDIS_PASSWORD=
APP_REDIS_TLS_ENABLED=false
APP_REDIS_TLS_SERVER_NAME=
APP_REDIS_TLS_CA_FILE=
APP_REDIS_TLS_CERT_FILE=
APP_REDIS_TLS_KEY_FILE=

APP_SESSION_SECRET=replace_with_32_chars_session_secret
APP_CONF_SALT=replace_with_32_chars_config_salt__
APP_BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
APP_BOOTSTRAP_APPLICATION_SECRET=replace_with_32_chars_application_secret
APP_RUN_MIGRATIONS=false
APP_RUN_SEEDS=false
APP_REQUIRE_SECURE_CONFIG=false
APP_ENFORCE_CASBIN_POLICY_COVERAGE=true
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:8008
APP_SECURITY_CORS_ALLOW_CREDENTIALS=false
APP_AUDIT_ACCESS_LOG_RETENTION_DAYS=0

SWEET_ADMIN_BASE_URL=http://localhost:8008/sweet_admin
SWEET_ADMIN_HEALTH_BASE_URL=http://localhost:9009
SWEET_ADMIN_ADMIN_USER=admin
SWEET_ADMIN_ADMIN_PASSWORD=replace_with_strong_admin_password
SWEET_ADMIN_EXTERNAL_TARGET_PURPOSE=development
SWEET_ADMIN_SMOKE_TABLE=sys_user
SWEET_ADMIN_SMOKE_CAPTCHA_ID=
SWEET_ADMIN_SMOKE_CAPTCHA=
SWEET_ADMIN_SMOKE_CAPTCHA_IMAGE_FILE=

APP_UPLOAD_DRIVER=local
APP_UPLOAD_DIR=/app/uploads
APP_UPLOAD_BASE_URL=/sweet_admin/files
APP_UPLOAD_MAX_SIZE=50
APP_UPLOAD_CHUNK_SIZE=5
APP_UPLOAD_CHUNK_TTL_HOURS=24
APP_UPLOAD_CHUNK_CLEANUP_MINUTES=60
APP_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip
APP_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip
APP_UPLOAD_PUBLIC_PREVIEW=false
APP_UPLOAD_OSS_ENDPOINT=
APP_UPLOAD_OSS_ACCESS_KEY_ID=
APP_UPLOAD_OSS_ACCESS_KEY_SECRET=
APP_UPLOAD_OSS_BUCKET_NAME=
APP_UPLOAD_OSS_BASE_URL=
APP_UPLOAD_OSS_BASE_PATH=uploads/

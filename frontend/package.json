{
  "name": "sweet-admin-frontend",
  "version": "0.0.1",
  "description": "Low-code management base for Sweet Admin",
  "productName": "Sweet Admin",
  "author": "Sweet Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "ci": "yarn lint && yarn typecheck && quasar build",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@open-file-viewer/core": "0.1.14",
    "@open-file-viewer/vue": "0.1.14",
    "@quasar/extras": "^1.18.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vueuse/core": "^12.7.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ajv": "^8.17.1",
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "pdfjs-dist": "6.0.227",
    "pinia": "^3.0.1",
    "qs": "^6.14.0",
    "quasar": "^2.20.1",
    "spark-md5": "^3.0.2",
    "vue": "^3.4.18",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.6.2",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.5.9",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "happy-dom": "^20.8.3",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}

{
  "name": "sweet-admin-frontend",
  "version": "0.0.1",
  "description": "Low-code management base for Sweet Admin",
  "productName": "Sweet Admin",
  "author": "Sweet Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "ci": "yarn lint && yarn typecheck && quasar build",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@open-file-viewer/core": "0.1.44",
    "@open-file-viewer/vue": "0.1.44",
    "@quasar/extras": "^2.0.4",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/presets": "0.25.1",
    "@univerjs/sheets-ui": "0.25.1",
    "@vueuse/core": "^14.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "lottie-web": "5.13.0",
    "pdfjs-dist": "6.3.289",
    "pinia": "^3.0.4",
    "qs": "^6.16.0",
    "quasar": "^2.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@quasar/app-vite": "^3.8.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.13.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "resolutions": {
    "**/@univerjs/core/nanoid": "5.1.16"
  },
  "engines": {
    "node": ">=22.23.0 <23",
    "yarn": ">= 1.21.1"
  }
}
